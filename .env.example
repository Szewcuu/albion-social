# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Never expose this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Discord integration
DISCORD_EXPEDITIONS_WEBHOOK_URL=
CRON_SECRET=

# Canonical production URL
NEXT_PUBLIC_APP_URL=https://albion-social.vercel.app

# Optional dedicated account for authenticated Playwright tests in CI.
# Do not use a personal or administrator account.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
