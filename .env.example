# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public Cloudflare Turnstile site key. Keep the secret key only in Supabase Auth settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Supabase key. Never expose this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Discord integration
DISCORD_EXPEDITIONS_WEBHOOK_URL=
CRON_SECRET=

# Canonical production URL
NEXT_PUBLIC_APP_URL=https://albion-social.vercel.app

# Optional dedicated non-staff member account for authenticated CI tests.
# The fixture never stores a password and uses a one-time admin link server-side.
E2E_USER_EMAIL=

# Optional: lets CI audit Vercel Preview deployments protected by Vercel Authentication.
# Generate it in Vercel Deployment Protection and store it only as a GitHub Actions secret.
VERCEL_AUTOMATION_BYPASS_SECRET=
