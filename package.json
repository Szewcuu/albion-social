{
  "name": "albion-social",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:e2e": "next start --hostname 127.0.0.1 --port 4173",
    "lint": "eslint",
    "test:unit": "node --experimental-default-type=module --test tests/unit/*.test.js",
    "catalog:sync": "node --experimental-default-type=module scripts/sync-albion-items.mjs",
    "catalog:validate": "node --experimental-default-type=module scripts/sync-albion-items.mjs --validate",
    "performance:budget": "node scripts/check-performance-budget.mjs",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --project=public",
    "test:e2e:auth": "cross-env E2E_REQUIRE_AUTH=1 playwright test --project=authenticated",
    "test:e2e:visual": "cross-env E2E_REQUIRE_AUTH=1 playwright test visual-public.spec.js visual-authenticated.spec.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.26.0",
    "next": "^16.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "cross-env": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.0"
  }
}
